    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 16px;
  }
  .form-section-title {
    font-size: 13px;
    font-weight: bold;
    color: #1F3864;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding-bottom: 8px;
    border-bottom: 1px solid #F3F4F6;
