    banco: 'Banco BHD'
  }
];

// ===========================
// STATE
// ===========================
let activeFilters = {
  tipos: new Set(['casa', 'apartamento', 'solar', 'local']),
  prov: '',
  banco: '',
  montoMax: 50,
  descMin: 0,
  sort: 'score'
};
let selectedServices = new Map();
let currentDetailId = null;
let serviceContext = null;

// ===========================
// FORMAT HELPERS
// ===========================
function fmt(n) {
  if (n >= 1000000) return 'RD$ ' + (n/1000000).toFixed(1) + 'M';
  if (n >= 1000) return 'RD$ ' + (n/1000).toFixed(0) + 'K';
  return 'RD$ ' + n;
}
function fmtFull(n) {
  return 'RD$ ' + n.toLocaleString('es-DO');
}
function calcDiscount(s) {
  return Math.round((1 - s.puja / s.mercado) * 100);
}
function discountClass(d) {
  if (d >= 25) return 'high';
  if (d >= 15) return 'mid';
  return 'low';
}

// ===========================
// RENDER RESULTS
// ===========================
function renderResults() {
  const list = document.getElementById('results-list');
  const filtered = subastas.filter(s => {
    if (!activeFilters.tipos.has(s.tipo)) return false;
    if (activeFilters.prov && !s.direccion.includes(activeFilters.prov)) return false;
    if (activeFilters.banco && s.banco !== activeFilters.banco) return false;
    if (s.puja > activeFilters.montoMax * 1000000) return false;
    if (calcDiscount(s) < activeFilters.descMin) return false;
    return true;
  });

  // Sort
  filtered.sort((a, b) => {
    if (activeFilters.sort === 'score') return b.score - a.score;
    if (activeFilters.sort === 'discount') return calcDiscount(b) - calcDiscount(a);
    if (activeFilters.sort === 'date') return a.dias - b.dias;
    if (activeFilters.sort === 'price') return a.puja - b.puja;
    return 0;
  });

  list.innerHTML = filtered.map(s => {
    const d = calcDiscount(s);
    const ppm = Math.round(s.puja / s.metraje);
    return `
      <div class="result-card" onclick="openDetail(${s.id})">
        <div class="result-thumb">
          <svg style="width:28px;height:28px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </div>
        <div class="result-info">
          <div class="result-title">${s.titulo}</div>
          <div class="result-meta">
            <span class="result-meta-item">${s.metraje} m²</span>
            <span class="result-meta-item">${fmt(s.puja)}</span>
            <span class="result-meta-item">${ppm.toLocaleString('es-DO')}/m²</span>
            <span class="result-meta-item">📅 ${s.fecha}</span>
          </div>
        </div>
        <div class="result-right">
          <span class="badge-discount ${discountClass(d)}">−${d}%</span>
          <span class="score-pill">Score ${s.score}</span>
          <span class="verified-badge">✓ Verificada</span>
        </div>
      </div>
    `;
  }).join('') || '<div style="text-align:center; padding:40px; color:#9CA3AF; background:white; border-radius:8px; border:1px solid #E5E7EB">No hay resultados con los filtros actuales</div>';

  // Update KPIs
  document.getElementById('count-results').textContent = filtered.length;
  document.getElementById('kpi-total').textContent = filtered.length;
  if (filtered.length > 0) {
    const discounts = filtered.map(calcDiscount).sort((a, b) => a - b);
    const median = discounts[Math.floor(discounts.length / 2)];
    document.getElementById('kpi-median').textContent = '−' + median + '%';
    document.getElementById('kpi-week').textContent = filtered.filter(s => s.dias <= 7).length;
  } else {
    document.getElementById('kpi-median').textContent = '—';
    document.getElementById('kpi-week').textContent = '0';
  }
}

// ===========================
// FILTERS
// ===========================
function toggleChip(el, group, val) {
  el.classList.toggle('active');
  if (el.classList.contains('active')) activeFilters.tipos.add(val);
  else activeFilters.tipos.delete(val);
  renderResults();
}

function applyFilters() {
  activeFilters.prov = document.getElementById('f-prov').value;
  activeFilters.banco = document.getElementById('f-banco').value;
  renderResults();
}

function updateMonto(v) {
  activeFilters.montoMax = parseInt(v);
  document.getElementById('monto-val').textContent = 'Hasta ' + v + ' M';
  renderResults();
}

function updateDesc(v) {
  activeFilters.descMin = parseInt(v);
  document.getElementById('desc-val').textContent = '≥ ' + v + '%';
  renderResults();
}

function sortResults(v) {
  activeFilters.sort = v;
  renderResults();
}

function resetFilters() {
  activeFilters = {
    tipos: new Set(['casa', 'apartamento', 'solar', 'local']),
    prov: '', banco: '', montoMax: 50, descMin: 0, sort: 'score'
  };
  document.getElementById('f-prov').value = '';
  document.getElementById('f-banco').value = '';
  document.getElementById('f-monto').value = 50;
  document.getElementById('f-desc').value = 0;
  document.getElementById('monto-val').textContent = 'Hasta 50 M';
  document.getElementById('desc-val').textContent = '≥ 0%';
  document.querySelectorAll('.chip').forEach(c => c.classList.add('active'));
  renderResults();
  showToast('Filtros restablecidos');
}

// ===========================
// MODAL DETAIL
// ===========================
function openDetail(id) {
  const s = subastas.find(x => x.id === id);
  if (!s) return;
  currentDetailId = id;
  const d = calcDiscount(s);
  const ppmPuja = Math.round(s.puja / s.metraje);
  const ppmZona = Math.round(s.mercado / s.metraje);

  document.getElementById('modal-title').textContent = s.titulo;
  document.getElementById('modal-subtitle').textContent =
    s.direccion + ' · ' + s.metraje + ' m² · Exp. ' + s.expediente;
  document.getElementById('modal-type').textContent = s.tipo;
  document.getElementById('modal-days').textContent = s.dias + ' días';

  document.getElementById('m-puja').textContent = fmt(s.puja);
  document.getElementById('m-judicial').textContent = fmt(s.judicial);
  document.getElementById('m-mercado').textContent = fmt(s.mercado);
  document.getElementById('m-desc').textContent = '−' + d + '%';

  document.getElementById('m-coords').textContent = s.coords;

  // Bars
  const max = s.mercado;
  document.getElementById('b-puja').textContent = fmt(s.puja);
  document.getElementById('b-judicial').textContent = fmt(s.judicial);
  document.getElementById('b-mercado').textContent = fmt(s.mercado);
  document.getElementById('bar-puja').style.width = (s.puja / max * 100) + '%';
  document.getElementById('bar-judicial').style.width = (s.judicial / max * 100) + '%';
  document.getElementById('bar-mercado').style.width = '100%';

  document.getElementById('m-ppm-puja').textContent = 'RD$ ' + ppmPuja.toLocaleString('es-DO');
  document.getElementById('m-ppm-zona').textContent = 'RD$ ' + ppmZona.toLocaleString('es-DO');

  // Parties
  document.getElementById('m-pers-name').textContent = s.persiguiente;
  document.getElementById('m-pers-id').textContent = s.persRnc;
  document.getElementById('m-pers-law').textContent = 'Abogado: ' + s.persLawyer;
  document.getElementById('m-perj-name').textContent = s.perjudicado;
  document.getElementById('m-perj-id').textContent = s.perjRnc;
  document.getElementById('m-perj-law').textContent = 'Abogado: ' + s.perjLawyer;
  document.getElementById('m-exp').textContent = ' ' + s.expediente;
  document.getElementById('m-juzg').textContent = ' ' + s.juzgado;

  renderHeatmap(ppmZona);

  document.getElementById('detail-modal').classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closeDetail() {
  document.getElementById('detail-modal').classList.remove('active');
  document.body.style.overflow = '';
}

function switchMap(el, type) {
  document.querySelectorAll('.map-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

function renderHeatmap(centerPrice) {
  const heatmap = document.getElementById('heatmap');
  heatmap.innerHTML = '';
  for (let i = 0; i < 25; i++) {
    const row = Math.floor(i / 5);
    const col = i % 5;
    const distFromCenter = Math.sqrt(Math.pow(row - 2, 2) + Math.pow(col - 2, 2));
    const variation = 1 + (Math.random() * 0.4 - 0.2);
    const price = Math.round(centerPrice * (1 - distFromCenter * 0.15) * variation);
    const intensity = Math.max(0, Math.min(1, 1 - distFromCenter / 3));
    const r = Math.round(255 - intensity * 100);
    const g = Math.round(150 - intensity * 50);
    const b = Math.round(100 + intensity * 50);
    const cell = document.createElement('div');
    cell.className = 'heat-cell';
    cell.style.background = `rgb(${r}, ${g}, ${b})`;
    cell.textContent = row === 2 && col === 2 ? '★' : Math.round(price / 1000) + 'k';
    if (row === 2 && col === 2) {
      cell.style.background = '#1F3864';
      cell.style.color = 'white';
      cell.style.border = '2px solid #C00000';
    }
    heatmap.appendChild(cell);
  }
}

function requestServiceFromDetail() {
  const s = subastas.find(x => x.id === currentDetailId);
  if (s) {
    serviceContext = { id: s.id, text: s.titulo + ' — ' + s.direccion + ' · Subasta ' + s.fecha };
    document.getElementById('ctx-text').textContent = serviceContext.text;
    document.getElementById('services-context-bar').classList.remove('hidden');
  }
  closeDetail();
  showSection('servicios');
}

// ===========================
// SECTIONS
// ===========================
function showSection(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  const navItem = document.querySelector(`.nav-item[onclick*="${id}"]`);
  if (navItem) navItem.classList.add('active');
  window.scrollTo(0, 0);
}

// ===========================
// SERVICES
// ===========================
function toggleService(card, key, price) {
  if (selectedServices.has(key)) {
    selectedServices.delete(key);
    card.classList.remove('selected');
    card.querySelector('.service-select-btn').textContent = 'Seleccionar';
  } else {
    selectedServices.set(key, { price, title: card.querySelector('.service-title').textContent });
    card.classList.add('selected');
    card.querySelector('.service-select-btn').textContent = '✓ Seleccionado';
  }
  updateServicesSummary();
}

function updateServicesSummary() {
  const summary = document.getElementById('services-summary');
  const list = document.getElementById('selected-list');
  if (selectedServices.size === 0) {
    summary.classList.add('hidden');
    return;
  }
  summary.classList.remove('hidden');
  let total = 0;
  let html = '';
  selectedServices.forEach((v, k) => {
    total += v.price;
    html += `
      <div class="summary-row">
        <span class="summary-label">${v.title}</span>
        <span class="summary-value">${fmtFull(v.price)}</span>
      </div>
    `;
  });
  list.innerHTML = html;
  document.getElementById('total-amount').textContent = fmtFull(total);
}

function clearContext() {
  serviceContext = null;
  document.getElementById('services-context-bar').classList.add('hidden');
}

function proceedToForm() {
  showSection('formulario');
}

function selectUrgency(el) {
  document.querySelectorAll('.urgency-opt').forEach(o => o.classList.remove('active'));
  el.classList.add('active');
}

function submitRequest() {
  // Add new request to table
  const tbody = document.getElementById('requests-tbody');
  const newId = 'SR-' + (42 + Math.floor(Math.random() * 50));
  const servicesText = Array.from(selectedServices.values()).map(s => s.title).join(', ');
  const total = Array.from(selectedServices.values()).reduce((sum, s) => sum + s.price, 0);
  const inmueble = serviceContext ? serviceContext.text.split('—')[0].trim() : 'Sin asociar';
  const today = new Date().toLocaleDateString('es-DO');

  const newRow = document.createElement('tr');
  newRow.innerHTML = `
    <td><strong>${newId}</strong></td>
    <td>${servicesText || 'Servicio general'}</td>
    <td>${inmueble}</td>
    <td>${today}</td>
    <td><span class="status-badge status-recibida">Recibida</span></td>
    <td>${fmtFull(total)}</td>
  `;
  tbody.insertBefore(newRow, tbody.firstChild);

  // Update total
  document.getElementById('req-total').textContent = parseInt(document.getElementById('req-total').textContent) + 1;

  // Reset selections
  selectedServices.clear();
  document.querySelectorAll('.service-card').forEach(c => {
    c.classList.remove('selected');
    const btn = c.querySelector('.service-select-btn');
    if (btn) btn.textContent = 'Seleccionar';
  });
  updateServicesSummary();
  clearContext();

  showSection('solicitudes');
  showToast('✓ Solicitud ' + newId + ' enviada correctamente', 'success');
}

// ===========================
// TOAST
// ===========================
function showToast(msg, type) {
  const toast = document.getElementById('toast');
  document.getElementById('toast-msg').textContent = msg;
  toast.classList.add('show');
  if (type === 'success') toast.classList.add('success');
  else toast.classList.remove('success');
  setTimeout(() => toast.classList.remove('show'), 3000);
}

// ===========================
// INIT
// ===========================
renderResults();
</script>

