<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CATA RED — Tecnología que conecta</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f7f6f3;--surface:#ffffff;--surface-2:#f0eee9;--ink:#15161a;--ink-2:#575b66;--ink-3:#8a8e99;--rule:#e3e0d9;
  --red:#c83c52;--red-soft:#fbe9ec;--magenta:#cc3072;--coral:#c24830;--ok:#1f8a5b;
  --net:rgba(200,60,82,.16);--net-dot:rgba(21,22,26,.22);
  --shadow:0 10px 30px rgba(21,22,26,.08);
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){color-scheme:dark;
    --bg:#0f1117;--surface:#171a23;--surface-2:#1f232e;--ink:#f1f2f5;--ink-2:#aeb3c0;--ink-3:#7c818e;--rule:#2a2f3b;
    --red:#e8536a;--red-soft:#3a1f26;--magenta:#e64a8c;--coral:#e8603f;--ok:#4cc38a;
    --net:rgba(232,83,106,.22);--net-dot:rgba(241,242,245,.28);--shadow:0 10px 30px rgba(0,0,0,.4)}
}
:root[data-theme="dark"]{color-scheme:dark;
  --bg:#0f1117;--surface:#171a23;--surface-2:#1f232e;--ink:#f1f2f5;--ink-2:#aeb3c0;--ink-3:#7c818e;--rule:#2a2f3b;
  --red:#e8536a;--red-soft:#3a1f26;--magenta:#e64a8c;--coral:#e8603f;--ok:#4cc38a;
  --net:rgba(232,83,106,.22);--net-dot:rgba(241,242,245,.28);--shadow:0 10px 30px rgba(0,0,0,.4)}
html{scroll-padding-top:calc(72px + env(safe-area-inset-top,0px));height:100%}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Sora",system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased;min-height:100%}
button{font:inherit;color:inherit}
img,svg{max-width:100%}
a{color:var(--red)}

/* Red de fondo */
.page-wrap{position:relative;z-index:1}

/* Barra superior */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--surface);z-index:30}
.topbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:color-mix(in srgb,var(--surface) 88%,transparent);border-bottom:1px solid var(--rule);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.topbar-in{max-width:1120px;margin:0 auto;padding:10px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit}
.brand svg{width:34px;height:34px}
.brand b{font-weight:800;font-size:19px;letter-spacing:-0.04em}
.brand b em{font-style:normal;color:var(--red)}
nav.menu{display:flex;gap:4px}
nav.menu a{text-decoration:none;color:var(--ink-2);font-size:14px;font-weight:500;padding:10px 14px;border-radius:10px;min-height:44px;display:flex;align-items:center}
nav.menu a:hover{background:var(--surface-2);color:var(--ink)}
nav.menu a[aria-current="page"]{color:var(--red);background:var(--red-soft)}
.tb-actions{display:flex;gap:8px}
.icon-btn{width:44px;height:44px;border-radius:12px;border:1px solid var(--rule);background:var(--surface);display:grid;place-items:center;cursor:pointer}
.icon-btn:hover{background:var(--surface-2)}
.icon-btn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.mobile-nav{display:none;position:fixed;left:0;right:0;bottom:0;z-index:25;background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid var(--rule);padding:6px 8px calc(6px + env(safe-area-inset-bottom,0px))}
.mobile-nav a{flex:1;text-decoration:none;color:var(--ink-3);font-size:11px;font-weight:500;display:flex;flex-direction:column;align-items:center;gap:4px;padding:6px 0;border-radius:10px;min-height:48px}
.mobile-nav a svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.mobile-nav a[aria-current="page"]{color:var(--red)}

/* Vistas */

/* Navegación sin JavaScript (:target) */
.view{display:none}
.view:target,.view:has(:target){display:block}
body:not(:has(.view:target)):not(:has(.view :target)) #view-inicio{display:block}
body:has(#view-servicios:target) [data-nav="servicios"],body:has(#view-servicios :target) [data-nav="servicios"],
body:has(#view-nosotros:target) [data-nav="nosotros"],
body:has(#view-contacto:target) [data-nav="contacto"],
body:not(:has(.view:target)):not(:has(.view :target)) [data-nav="inicio"],
body:has(#view-inicio:target) [data-nav="inicio"]{color:var(--red)}
nav.menu a[data-nav]{background:transparent}
body:has(#view-servicios:target) nav.menu [data-nav="servicios"],body:has(#view-servicios :target) nav.menu [data-nav="servicios"],
body:has(#view-nosotros:target) nav.menu [data-nav="nosotros"],
body:has(#view-contacto:target) nav.menu [data-nav="contacto"],
body:not(:has(.view:target)):not(:has(.view :target)) nav.menu [data-nav="inicio"],
body:has(#view-inicio:target) nav.menu [data-nav="inicio"]{background:var(--red-soft)}
.chip{text-decoration:none;color:inherit}
.line{scroll-margin-top:calc(150px + env(safe-area-inset-top,0px))}

/* Red de fondo en SVG animada con CSS */
#net{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:.9}
#net .cl{animation:drift var(--d,40s) ease-in-out infinite alternate;transform-origin:center}
#net .cl line{stroke:var(--net);stroke-width:1}
#net .cl circle{fill:var(--net-dot)}
#net .cl circle.hot{fill:var(--red);animation:pulse 3.2s ease-in-out infinite}
#net .cl.a{--d:38s}#net .cl.b{--d:52s;animation-direction:alternate-reverse}#net .cl.c{--d:45s}
@keyframes drift{0%{transform:translate(0,0)}50%{transform:translate(var(--dx,30px),var(--dy,-20px))}100%{transform:translate(calc(var(--dx,30px) * -.6),var(--dy2,25px))}}
@keyframes pulse{0%,100%{opacity:.55;r:3}50%{opacity:1;r:4.5}}
@media (prefers-reduced-motion: reduce){#net .cl,#net circle{animation:none!important}}
.container{max-width:1120px;margin:0 auto;padding:0 20px}

/* Inicio: hero con órbita */
.hero{max-width:1120px;margin:0 auto;padding:48px 20px 24px;display:grid;grid-template-columns:1.05fr .95fr;gap:32px;align-items:center;min-height:calc(100svh - 70px)}
.hero h1{margin:0 0 14px;font-size:clamp(36px,6vw,62px);font-weight:800;letter-spacing:-0.045em;line-height:1.02}
.hero h1 em{font-style:normal;color:var(--red)}
.hero p{margin:0 0 24px;color:var(--ink-2);font-size:17px;max-width:46ch}
.cta-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:28px}
.btn{display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 20px;border-radius:14px;font-weight:600;font-size:15px;text-decoration:none;border:1px solid transparent;cursor:pointer}
.btn-primary{background:var(--red);color:#fff}
.btn-primary:hover{filter:brightness(1.08)}
.btn-ghost{background:var(--surface);border-color:var(--rule);color:var(--ink)}
.btn-ghost:hover{background:var(--surface-2)}
.hero-stats{display:flex;gap:28px;flex-wrap:wrap}
.hero-stats div{display:flex;flex-direction:column}
.hero-stats b{font-size:30px;font-weight:800;letter-spacing:-0.03em;line-height:1}
.hero-stats span{font-size:13px;color:var(--ink-3)}

.orbit-wrap{position:relative;container-type:inline-size;width:min(100%,440px);aspect-ratio:1/1;margin:0 auto}
.orbit-glow{position:absolute;inset:8%;border-radius:50%;background:radial-gradient(circle,var(--red-soft) 0%,transparent 70%)}
.orbit-ring{position:absolute;inset:0;border-radius:50%;animation:spin 36s linear infinite}
.orbit-ring.r2{inset:19%;animation:spin 24s linear infinite reverse}
.orbit-ring::before{content:"";position:absolute;inset:0;border-radius:50%;border:1.5px dashed var(--rule)}
.orbit-ring.r2::before{border-style:solid}
.sat{position:absolute;top:50%;left:50%;width:56px;height:56px;margin:-28px 0 0 -28px;transform:rotate(var(--a)) translate(var(--r)) rotate(calc(-1 * var(--a)));}
.sat > span{display:grid;place-items:center;width:100%;height:100%;border-radius:50%;background:var(--surface);border:1px solid var(--rule);box-shadow:var(--shadow);animation:unspin 36s linear infinite}
.orbit-ring.r2 .sat > span{animation:unspin 24s linear infinite reverse}
.sat svg{width:24px;height:24px;stroke:var(--ink);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.sat.accent > span{background:var(--red);border-color:var(--red)}
.sat.accent svg{stroke:#fff}
.sat.small{width:40px;height:40px;margin:-20px 0 0 -20px}
.sat.small svg{width:18px;height:18px}
.core{position:absolute;inset:34%;border-radius:50%;background:var(--surface);border:1px solid var(--rule);box-shadow:var(--shadow);display:grid;place-items:center;animation:breathe 6s ease-in-out infinite}
.core svg{width:70%;height:70%}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes unspin{to{transform:rotate(-360deg)}}
@keyframes breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}

/* Inicio: líneas destacadas */
.section{padding:48px 0}
.section-head{margin-bottom:22px}
.section-head h2{margin:0 0 6px;font-size:clamp(26px,4vw,36px);font-weight:800;letter-spacing:-0.035em;line-height:1.1}
.section-head p{margin:0;color:var(--ink-2);font-size:16px;max-width:60ch}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.tile{display:flex;flex-direction:column;gap:10px;padding:20px;border-radius:18px;background:var(--surface);border:1px solid var(--rule);text-decoration:none;color:inherit;min-height:150px}
.tile:hover{box-shadow:var(--shadow);border-color:transparent}
.tile .ico{width:48px;height:48px}
.tile .ico svg{width:24px;height:24px}
.tile h3{margin:0;font-size:16px;font-weight:600}
.tile p{margin:0;font-size:13.5px;color:var(--ink-2)}
.tile b{font-size:12px;color:var(--red);font-weight:600;margin-top:auto}

/* Servicios */
.controls{position:sticky;top:calc(65px + env(safe-area-inset-top,0px));z-index:15;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);padding:8px 0 10px}
.controls-in{max-width:1120px;margin:0 auto;padding:0 20px;display:flex;flex-direction:column;gap:10px}
.search{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--rule);border-radius:14px;padding:0 14px;height:48px}
.search svg{width:18px;height:18px;stroke:var(--ink-3);fill:none;stroke-width:2;stroke-linecap:round}
.search input{flex:1;border:0;background:transparent;outline:none;font:inherit;font-size:15px;color:var(--ink);min-width:0}
.search input::placeholder{color:var(--ink-3)}
.chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;height:38px;padding:0 14px;border-radius:999px;border:1px solid var(--rule);background:var(--surface);font-size:13.5px;font-weight:500;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:6px}
.chip small{color:var(--ink-3);font-weight:500}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.chip[aria-pressed="true"] small{color:inherit;opacity:.7}
.catalog{max-width:1120px;margin:0 auto;padding:12px 20px 80px}
.line{margin-top:28px}
.line-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:14px}
.line-head h2{margin:0;font-size:22px;font-weight:800;letter-spacing:-0.03em;line-height:1.15}
.line-head p{margin:4px 0 0;color:var(--ink-2);font-size:14px}
.line-head .n{flex:none;font-size:13px;color:var(--ink-3);font-weight:500}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px}
.card{background:var(--surface);border:1px solid var(--rule);border-radius:18px;overflow:hidden;transition:box-shadow .2s,border-color .2s}
.card[open]{box-shadow:var(--shadow);border-color:transparent}
.card summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:56px 1fr 28px;gap:14px;align-items:center;padding:14px 16px 14px 14px;min-height:84px}
.card summary::-webkit-details-marker{display:none}
.card summary:focus-visible{outline:2px solid var(--red);outline-offset:-2px;border-radius:18px}
.ico{width:56px;height:56px;border-radius:14px;background:var(--surface-2);display:grid;place-items:center}
.ico svg{width:28px;height:28px;stroke:var(--red);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.card h3{margin:0;font-size:15.5px;font-weight:600;letter-spacing:-0.01em;line-height:1.3}
.card .short{margin:2px 0 0;font-size:13px;color:var(--ink-2);line-height:1.4}
.chev{width:28px;height:28px;border-radius:50%;background:var(--surface-2);display:grid;place-items:center;transition:transform .25s}
.chev svg{width:14px;height:14px;stroke:var(--ink-2);fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.card[open] .chev{transform:rotate(180deg);background:var(--red-soft)}
.card[open] .chev svg{stroke:var(--red)}
.body{padding:0 16px 18px}
.art{width:100%;aspect-ratio:16/7;border-radius:12px;overflow:hidden;background:var(--surface-2);margin-bottom:14px}
.art svg{width:100%;height:100%;display:block}
.body p{margin:0 0 12px;font-size:14px;color:var(--ink-2)}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tag{font-size:12px;font-weight:500;padding:4px 10px;border-radius:999px;background:var(--red-soft);color:var(--red)}
.status{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;color:var(--ink-3);margin-top:10px}
.status i{width:8px;height:8px;border-radius:50%;background:var(--ok)}
.status.plan i{background:var(--coral)}
.empty{padding:60px 20px;text-align:center;color:var(--ink-2)}
.empty b{display:block;font-size:18px;color:var(--ink);margin-bottom:6px}

/* Quiénes somos */
.about-hero{padding:56px 0 24px}
.about-hero h1{margin:0 0 14px;font-size:clamp(32px,5vw,52px);font-weight:800;letter-spacing:-0.04em;line-height:1.05;max-width:18ch}
.about-hero p{margin:0;color:var(--ink-2);font-size:17px;max-width:60ch}
.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.panel{background:var(--surface);border:1px solid var(--rule);border-radius:20px;padding:26px}
.panel h3{margin:0 0 8px;font-size:19px;font-weight:700;letter-spacing:-0.02em}
.panel p{margin:0;color:var(--ink-2);font-size:14.5px}
.panel .mini{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.panel .mini svg{width:36px;height:36px}
.values{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}
.value{padding:20px;border-radius:16px;background:var(--surface);border:1px solid var(--rule)}
.value b{display:block;font-size:15px;margin-bottom:4px}
.value span{font-size:13.5px;color:var(--ink-2)}
.timeline{display:grid;gap:0;border-left:2px solid var(--rule);margin-left:8px;padding-left:22px}
.tl{position:relative;padding:0 0 22px}
.tl::before{content:"";position:absolute;left:-30px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--red)}
.tl b{display:block;font-size:15px}
.tl span{font-size:13.5px;color:var(--ink-2)}

/* Contacto */
.contact{display:grid;grid-template-columns:1fr 1.1fr;gap:16px;padding-bottom:80px}
.c-item{display:flex;gap:14px;align-items:flex-start;padding:16px 0;border-bottom:1px solid var(--rule)}
.c-item:last-child{border-bottom:0}
.c-item .ico{width:44px;height:44px;flex:none}
.c-item .ico svg{width:22px;height:22px}
.c-item b{display:block;font-size:14px}
.c-item span,.c-item a{font-size:14px;color:var(--ink-2)}
form{display:flex;flex-direction:column;gap:12px}
.f-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
label.f{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:500;color:var(--ink-2)}
label.f input,label.f select,label.f textarea{font:inherit;font-size:15px;color:var(--ink);background:var(--bg);border:1px solid var(--rule);border-radius:12px;padding:12px 14px;min-height:48px;outline:none}
label.f input:focus,label.f select:focus,label.f textarea:focus{border-color:var(--red)}
label.f textarea{min-height:120px;resize:vertical}
.note{font-size:12.5px;color:var(--ink-3)}

footer{border-top:1px solid var(--rule);background:var(--surface)}
.foot-in{max-width:1120px;margin:0 auto;padding:28px 20px calc(28px + env(safe-area-inset-bottom,0px));display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;align-items:center;color:var(--ink-2);font-size:13px}
.foot-in .brand b{font-size:17px}

@media (max-width:820px){
  nav.menu{display:none}
  .mobile-nav{display:flex}
  body{padding-bottom:72px}
  .hero{grid-template-columns:1fr;padding-top:20px;gap:12px;min-height:auto}
  .orbit-wrap{width:min(100%,300px);order:-1}
  .sat{width:44px;height:44px;margin:-22px 0 0 -22px}
  .sat svg{width:20px;height:20px}
  .sat.small{width:32px;height:32px;margin:-16px 0 0 -16px}
  .grid,.two,.contact,.f-row{grid-template-columns:1fr}
  .foot-in{padding-bottom:28px}
}
@media (prefers-reduced-motion: reduce){
  *{transition:none!important}
  .orbit-ring,.sat > span,.core{animation:none!important}
}
</style>
</head>
